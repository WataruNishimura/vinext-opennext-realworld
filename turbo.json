{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".open-next/**",
        ".cloudflare/output/**",
        "dist/**"
      ]
    },
    "@realworld/next#build": {
      "dependsOn": ["^build"],
      "env": [
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_D1_DATABASE_ID",
        "CLOUDFLARE_D1_API_TOKEN",
        "CLOUDFLARE_API_BASE_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
