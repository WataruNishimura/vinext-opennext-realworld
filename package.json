{
  "name": "vinext-opennext-realworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "vrt": "pnpm --filter @realworld/vrt vrt",
    "db:generate": "pnpm --filter @realworld/db db:generate",
    "db:migrate:local": "pnpm --filter @realworld/db db:migrate:local",
    "db:seed:local": "pnpm --filter @realworld/db db:seed:local"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
