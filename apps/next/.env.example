# Server-only: the app reaches the existing Cloudflare D1 database over the D1 REST API.
# Copy to .env.local for local runs against the real database, or set them in the Vercel project.
# Without CLOUDFLARE_D1_API_TOKEN, `pnpm dev`, `pnpm build` and `pnpm start` use a local, seeded
# D1 database in Miniflare instead (scripts/with-d1.ts).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=7c6d99ba-4407-484b-8fd8-4fb8dbf07bbc
# An API token with the "D1 Edit" permission for the account (D1 Read is not enough: the cart,
# saved products and profile write to D1).
CLOUDFLARE_D1_API_TOKEN=

# Optional: another API base URL (default https://api.cloudflare.com/client/v4). scripts/with-d1.ts
# sets it to the local emulator.
# CLOUDFLARE_API_BASE_URL=
