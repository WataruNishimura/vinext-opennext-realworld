{
  "name": "@realworld/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts",
    "./render-stages": {
      "vinext": "./src/framework/render-stages.vinext.ts",
      "default": "./src/framework/render-stages.ts"
    },
    "./category/*": "./src/category/*.ts",
    "./product/*": "./src/product/*.ts",
